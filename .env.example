# Copy this file to .env on the Asterisk server and fill real values there.
# Do NOT commit .env to GitHub.

# HTTP gateway
HOST=127.0.0.1
PORT=8088
GATEWAY_BASE_URL=http://127.0.0.1:8088
# Optional shared token for requests from AGI/Asterisk-side logic.
GATEWAY_TOKEN=

# AMI
AMI_HOST=<ASTERISK_AMI_HOST>
AMI_PORT=5038
AMI_USERNAME=<AMI_USERNAME>
AMI_SECRET=<AMI_SECRET>
AMI_CONNECT_TIMEOUT=5

# Asterisk originate
ASTERISK_CHANNEL_TECH=SIP
ASTERISK_TRUNK=<ASTERISK_TRUNK_NAME>
# For chan_sip usually one of these:
#   SIP/{phone}@provider
#   SIP/provider/{phone}
ASTERISK_CHANNEL_TEMPLATE=SIP/{phone}@<ASTERISK_TRUNK_NAME>
ASTERISK_CONTEXT=n8n-gateway-call
ASTERISK_EXTENSION=s
ASTERISK_PRIORITY=1
CALLER_ID=n8n-gateway <70000000000>
ORIGINATE_TIMEOUT_MS=45000

# Audio paths
AUDIO_WORK_DIR=/var/lib/n8n-asterisk-gateway
ASTERISK_SOUNDS_DIR=/var/lib/asterisk/sounds/n8n-gateway
ASTERISK_RECORDINGS_DIR=/var/spool/asterisk/monitor/n8n-gateway

# Recording defaults
RECORD_MAX_SECONDS=10
RECORD_SILENCE_SECONDS=2
RECORD_BEEP=false
MAX_TURNS=20

# HTTP timeouts
DOWNLOAD_TIMEOUT_SECONDS=30
N8N_TIMEOUT_SECONDS=120
