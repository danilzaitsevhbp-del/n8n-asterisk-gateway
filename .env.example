# HTTP gateway
HOST=127.0.0.1
PORT=8088
GATEWAY_BASE_URL=http://127.0.0.1:8088
GATEWAY_TOKEN=

# FastAGI server. Asterisk dialplan should use agi://127.0.0.1:4573/...
FASTAGI_HOST=127.0.0.1
FASTAGI_PORT=4573

# AMI. Put real values only into .env on the server, not into GitHub.
AMI_HOST=<ASTERISK_AMI_HOST>
AMI_PORT=5038
AMI_USERNAME=<AMI_USERNAME>
AMI_SECRET=<AMI_SECRET>
AMI_CONNECT_TIMEOUT=5

# Asterisk originate
ASTERISK_CHANNEL_TECH=PJSIP
ASTERISK_TRUNK=<ASTERISK_TRUNK_NAME>
ASTERISK_CHANNEL_TEMPLATE=PJSIP/{phone}@{trunk}
ASTERISK_CONTEXT=n8n-gateway-call
ASTERISK_EXTENSION=s
ASTERISK_PRIORITY=1
CALLER_ID=n8n-gateway <70000000000>
ORIGINATE_TIMEOUT_MS=45000

# Local-only paths in user's home directory
AUDIO_WORK_DIR=/home/danil_z/n8n-asterisk-gateway/data
ASTERISK_SOUNDS_DIR=/home/danil_z/n8n-asterisk-gateway/data/sounds
ASTERISK_RECORDINGS_DIR=/home/danil_z/n8n-asterisk-gateway/data/recordings

# Recording defaults
RECORD_MAX_SECONDS=10
RECORD_SILENCE_SECONDS=2
RECORD_BEEP=false
MAX_TURNS=20

# HTTP timeouts
DOWNLOAD_TIMEOUT_SECONDS=30
N8N_TIMEOUT_SECONDS=120
